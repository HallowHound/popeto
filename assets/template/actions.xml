<?xml version="1.0" encoding="UTF-8" ?>
<!-- Generated by Popeto from a converted pet. {{name}} placeholders are filled with the pet's frames. -->
<Mascot xmlns="http://www.group-finity.com/Mascot">
	<ActionList>
		<Action Name="Look" Type="Embedded" Class="com.group_finity.mascot.action.Look" />
		<Action Name="Offset" Type="Embedded" Class="com.group_finity.mascot.action.Offset" />

		<Action Name="Stand" Type="Stay" BorderType="Floor"><Animation>{{stand}}</Animation></Action>
		<Action Name="Walk" Type="Move" BorderType="Floor"><Animation>{{walk}}</Animation></Action>
		<Action Name="Run" Type="Move" BorderType="Floor"><Animation>{{run}}</Animation></Action>
		<Action Name="Dash" Type="Move" BorderType="Floor"><Animation>{{dash}}</Animation></Action>
		<Action Name="Sit" Type="Stay" BorderType="Floor"><Animation>{{sit}}</Animation></Action>
		<Action Name="SitDownPose" Type="Stay" BorderType="Floor"><Animation>{{sit_down}}</Animation></Action>
		<Action Name="SitAndLookUp" Type="Stay" BorderType="Floor"><Animation>{{sit_look_up}}</Animation></Action>
		<Action Name="SitAndDangleLegs" Type="Stay" BorderType="Floor"><Animation>{{sit_dangle}}</Animation></Action>
		<Action Name="Sprawl" Type="Stay" BorderType="Floor"><Animation>{{sprawl}}</Animation></Action>
		<Action Name="Creep" Type="Move" BorderType="Floor"><Animation>{{creep}}</Animation></Action>
		<Action Name="Wink" Type="Animate" BorderType="Floor"><Animation>{{wink}}</Animation></Action>
		<Action Name="Tripping" Type="Animate" BorderType="Floor"><Animation>{{tripping}}</Animation></Action>
		<Action Name="Bouncing" Type="Animate" BorderType="Floor"><Animation>{{bounce}}</Animation></Action>

		<Action Name="GrabWall" Type="Stay" BorderType="Wall"><Animation>{{grab_wall}}</Animation></Action>
		<Action Name="ClimbWall" Type="Move" BorderType="Wall">
			<Animation Condition="#{TargetY &lt; mascot.anchor.y}">{{climb_up}}</Animation>
			<Animation Condition="#{TargetY &gt;= mascot.anchor.y}">{{climb_down}}</Animation>
		</Action>
		<Action Name="GrabCeiling" Type="Stay" BorderType="Ceiling"><Animation>{{grab_ceiling}}</Animation></Action>
		<Action Name="ClimbCeiling" Type="Move" BorderType="Ceiling"><Animation>{{ceiling}}</Animation></Action>

		<Action Name="Falling" Type="Embedded" Class="com.group_finity.mascot.action.Fall" RegistanceX="0.05" RegistanceY="0.1" Gravity="2">
			<Animation>{{fall}}</Animation>
		</Action>
		<Action Name="Jumping" Type="Embedded" Class="com.group_finity.mascot.action.Jump" VelocityParam="20">
			<Animation>{{jump}}</Animation>
		</Action>
		<Action Name="JumpOff" Type="Animate"><Animation>{{jump_off}}</Animation></Action>
		<Action Name="Pinched" Type="Embedded" Class="com.group_finity.mascot.action.Dragged" OffsetX="0" OffsetY="{{drag_offset}}">
			<Animation>{{drag}}</Animation>
		</Action>
		<Action Name="Resisting" Type="Embedded" Class="com.group_finity.mascot.action.Regist" OffsetX="0" OffsetY="{{drag_offset}}">
			<Animation>{{resist}}</Animation>
		</Action>
	</ActionList>

	<ActionList>
		<Action Name="Fall" Type="Sequence" Loop="false">
			<ActionReference Name="Falling" />
			<Action Type="Select">
				<Action Type="Sequence" Condition="${mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}">
					<ActionReference Name="Bouncing" />
					<ActionReference Name="Stand" Duration="${100+Math.random()*100}" />
				</Action>
				<ActionReference Name="GrabWall" Duration="100" />
			</Action>
		</Action>
		<Action Name="Dragged" Type="Sequence" Loop="true">
			<ActionReference Name="Pinched" />
			<ActionReference Name="Resisting" />
		</Action>
		<Action Name="Thrown" Type="Sequence" Loop="false">
			<ActionReference Name="Falling" InitialVX="${mascot.environment.cursor.dx}" InitialVY="${mascot.environment.cursor.dy}" />
			<Action Type="Select">
				<Action Type="Sequence" Condition="${mascot.environment.floor.isOn(mascot.anchor) || mascot.environment.activeIE.topBorder.isOn(mascot.anchor)}">
					<ActionReference Name="Bouncing" />
					<ActionReference Name="Stand" Duration="${100+Math.random()*100}" />
				</Action>
				<ActionReference Name="GrabWall" Duration="100" />
			</Action>
		</Action>

		<Action Name="StandUp" Type="Sequence"><ActionReference Name="Stand" Duration="${100+Math.random()*200}" /></Action>
		<Action Name="SitDown" Type="Sequence"><ActionReference Name="Sit" Duration="${300+Math.random()*500}" /></Action>
		<Action Name="SitAndRest" Type="Sequence"><ActionReference Name="SitDownPose" Duration="${300+Math.random()*500}" /></Action>
		<Action Name="LookUp" Type="Sequence"><ActionReference Name="SitAndLookUp" Duration="${200+Math.random()*300}" /></Action>
		<Action Name="DangleLegs" Type="Sequence"><ActionReference Name="SitAndDangleLegs" Duration="${300+Math.random()*500}" /></Action>
		<Action Name="SprawlOut" Type="Sequence"><ActionReference Name="Sprawl" Duration="${300+Math.random()*600}" /></Action>
		<Action Name="WinkAtYou" Type="Sequence"><ActionReference Name="Wink" /><ActionReference Name="Stand" Duration="${20+Math.random()*30}" /></Action>
		<Action Name="CreepAround" Type="Sequence">
			<ActionReference Name="Creep" TargetX="${mascot.anchor.x+(Math.random()&lt;0.5?-1:1)*(100+Math.random()*200)}" />
		</Action>
		<Action Name="WalkAndTrip" Type="Sequence">
			<ActionReference Name="Run" TargetX="${mascot.environment.workArea.left+64+Math.random()*(mascot.environment.workArea.width-128)}" />
			<ActionReference Name="Tripping" />
			<ActionReference Name="Stand" Duration="${30+Math.random()*30}" />
		</Action>

		<Action Name="WalkAlongWorkAreaFloor" Type="Sequence">
			<ActionReference Name="Walk" TargetX="${mascot.environment.workArea.left+64+Math.random()*(mascot.environment.workArea.width-128)}" />
		</Action>
		<Action Name="RunAlongWorkAreaFloor" Type="Sequence">
			<ActionReference Name="Run" TargetX="${mascot.environment.workArea.left+64+Math.random()*(mascot.environment.workArea.width-128)}" />
		</Action>
		<Action Name="GrabWorkAreaBottomLeftWall" Type="Sequence">
			<ActionReference Name="Walk" TargetX="#{mascot.environment.workArea.left}" />
			<ActionReference Name="ClimbWall" TargetY="#{mascot.environment.workArea.bottom-64}" />
		</Action>
		<Action Name="GrabWorkAreaBottomRightWall" Type="Sequence">
			<ActionReference Name="Walk" TargetX="#{mascot.environment.workArea.right}" />
			<ActionReference Name="ClimbWall" TargetY="#{mascot.environment.workArea.bottom-64}" />
		</Action>
		<Action Name="HoldOntoWall" Type="Sequence"><ActionReference Name="GrabWall" Duration="${100+Math.random()*100}" /></Action>
		<Action Name="FallFromWall" Type="Sequence">
			<ActionReference Name="Offset" X="${mascot.lookRight ? -1 : 1}" />
			<ActionReference Name="Stand" />
		</Action>
		<Action Name="ClimbHalfwayAlongWall" Type="Sequence">
			<ActionReference Name="ClimbWall" TargetY="${mascot.environment.workArea.top+64+Math.random()*(mascot.environment.workArea.height-128)}" />
		</Action>
		<Action Name="ClimbAlongWall" Type="Sequence">
			<ActionReference Name="ClimbWall" TargetY="#{mascot.environment.workArea.top+64}" />
			<ActionReference Name="Offset" Y="-64" />
			<ActionReference Name="Look" />
			<ActionReference Name="ClimbCeiling" TargetX="${mascot.lookRight ? mascot.environment.workArea.left+64+Math.random()*100 : mascot.environment.workArea.right-64-Math.random()*100}" />
		</Action>
		<Action Name="HoldOntoCeiling" Type="Sequence"><ActionReference Name="GrabCeiling" Duration="${100+Math.random()*100}" /></Action>
		<Action Name="FallFromCeiling" Type="Sequence">
			<ActionReference Name="Offset" Y="1" />
			<ActionReference Name="Stand" />
		</Action>
		<Action Name="ClimbAlongCeiling" Type="Sequence">
			<ActionReference Name="ClimbCeiling" TargetX="${mascot.environment.workArea.left+64+Math.random()*(mascot.environment.workArea.width-128)}" />
		</Action>
		<Action Name="JumpFromLeftWall" Type="Sequence">
			<ActionReference Name="Jumping" TargetX="${mascot.environment.workArea.left}" TargetY="${mascot.environment.workArea.bottom-Math.random()*mascot.environment.workArea.height/4}" />
			<ActionReference Name="GrabWall" Duration="${100+Math.random()*100}" />
		</Action>
		<Action Name="JumpFromRightWall" Type="Sequence">
			<ActionReference Name="Jumping" TargetX="${mascot.environment.workArea.right}" TargetY="${mascot.environment.workArea.bottom-Math.random()*mascot.environment.workArea.height/4}" />
			<ActionReference Name="GrabWall" Duration="${100+Math.random()*100}" />
		</Action>

		<Action Name="WalkAlongIECeiling" Type="Sequence">
			<ActionReference Name="Walk" TargetX="${mascot.environment.activeIE.left+64+Math.random()*(mascot.environment.activeIE.width-128)}" />
		</Action>
		<Action Name="SitOnTheEdgeOfIE" Type="Sequence">
			<ActionReference Name="Walk" TargetX="${Math.random()&lt;0.5 ? mascot.environment.activeIE.left+20 : mascot.environment.activeIE.right-20}" />
			<ActionReference Name="SitAndDangleLegs" Duration="${200+Math.random()*300}" />
		</Action>
		<Action Name="JumpFromLeftEdgeOfIE" Type="Sequence">
			<ActionReference Name="Walk" TargetX="${mascot.environment.activeIE.left+Math.random()*50}" />
			<ActionReference Name="JumpOff" />
			<ActionReference Name="Falling" InitialVX="-1" InitialVY="${-10-Math.random()*5}" />
			<ActionReference Name="Bouncing" />
		</Action>
		<Action Name="JumpFromRightEdgeOfIE" Type="Sequence">
			<ActionReference Name="Walk" TargetX="${mascot.environment.activeIE.right-Math.random()*50}" />
			<ActionReference Name="JumpOff" />
			<ActionReference Name="Falling" InitialVX="1" InitialVY="${-10-Math.random()*5}" />
			<ActionReference Name="Bouncing" />
		</Action>
		<Action Name="JumpFromBottomOfIE" Type="Sequence">
			<ActionReference Name="Jumping" TargetX="${(mascot.anchor.x*3+mascot.environment.activeIE.left+Math.random()*mascot.environment.activeIE.width)/4}" TargetY="${mascot.environment.activeIE.bottom}" />
			<ActionReference Name="GrabCeiling" Duration="${100+Math.random()*100}" />
		</Action>
		<Action Name="ClimbIEBottom" Type="Sequence">
			<ActionReference Name="ClimbCeiling" TargetX="${mascot.environment.activeIE.left+64+Math.random()*(mascot.environment.activeIE.width-128)}" />
		</Action>
		<Action Name="HoldOntoIEWall" Type="Sequence">
			<ActionReference Name="ClimbWall" TargetY="${mascot.environment.activeIE.top+64+Math.random()*(mascot.environment.activeIE.height-128)}" />
		</Action>
		<Action Name="ClimbIEWall" Type="Sequence">
			<ActionReference Name="ClimbWall" TargetY="#{mascot.environment.activeIE.top+64}" />
			<ActionReference Name="Offset" Y="-64" />
			<ActionReference Name="Stand" Duration="${10+Math.random()*10}" />
		</Action>
		<Action Name="JumpOnIELeftWall" Type="Sequence">
			<ActionReference Name="Jumping" TargetX="${mascot.environment.activeIE.left}" TargetY="${mascot.environment.activeIE.bottom-Math.random()*mascot.environment.activeIE.height/4}" />
			<ActionReference Name="GrabWall" Duration="${100+Math.random()*100}" />
		</Action>
		<Action Name="JumpOnIERightWall" Type="Sequence">
			<ActionReference Name="Jumping" TargetX="${mascot.environment.activeIE.right}" TargetY="${mascot.environment.activeIE.bottom-Math.random()*mascot.environment.activeIE.height/4}" />
			<ActionReference Name="GrabWall" Duration="${100+Math.random()*100}" />
		</Action>

		<Action Name="ChaseMouse" Type="Sequence" Loop="false">
			<ActionReference Name="Dash" TargetX="${mascot.anchor.x+(mascot.environment.cursor.x-mascot.anchor.x)*Math.random()/2}" />
			<ActionReference Name="Tripping" Condition="${Math.random() &lt; 0.05}" />
			<ActionReference Name="Dash" TargetX="#{mascot.environment.cursor.x}" />
			<ActionReference Name="Look" LookRight="${mascot.anchor.x &lt; mascot.environment.cursor.x}" />
		</Action>
	</ActionList>
</Mascot>
